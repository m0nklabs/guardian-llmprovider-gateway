# Guardian LLM Provider Gateway — environment template.
#
# Copy to .env and fill in. Values are referenced from YAML via ${VAR}
# expansion (config/global.settings.yaml, config/providers/*.settings.yaml).
# NEVER commit the real .env (gitignored).

# ── Cloud provider API keys (consumed by the matching provider file) ──
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
POOLSIDE_API_KEY=

# ── Local engine paths (llama.cpp backend) ──
# Empty values fall back to app/paths.py defaults:
#   LLAMA_SERVER_BINARY = LLAMA_CPP_OFFICIAL_ROOT/build/bin/llama-server
#   MODELS_DIR          = <repo parent>/models
LLAMA_SERVER_BINARY=
LLAMA_CPP_OFFICIAL_ROOT=
MODELS_DIR=
CUDA_HOME=
TURBO_AUTO_ASYMMETRIC=

# ── Caretaker daemon (remote-first backend lifecycle, F5) ──
# Bearer token sent to the caretaker daemon (default http://127.0.0.1:11441).
# Must match the daemon's own auth config; leave empty to run without it
# (the gateway then falls back to local backend management).
CARETAKER_KEY=

# ── Capture subsystem secrets (optional; fail-open when absent) ──
GUARDIAN_CAPTURE_CLIENT_REF_SECRET=
GUARDIAN_CAPTURE_INSTANCE_ID=
GUARDIAN_CAPTURE_RECORD_AUTH_SECRET=
